    8) Como ordenar pela segunda ou terceira chave
        Exemplo uma lista de Alunos(codigo, curso, nome) - ordenar por curso e ordenar por nome
      * void bolha(Aluno* vetor, int n) {
        bool trocou;
        for (int i = 0; i < n - 1; i++) {
          trocou = false;
            for (int j = 0; j < n - 1 - i; j++) {
                // Comparar curso primeiro
                  if (vetor[j].curso > vetor[j + 1].curso) {
                    // Trocar se curso de j for maior que o de j+1
                      Aluno temp = vetor[j];
                      vetor[j] = vetor[j + 1];
                      vetor[j + 1] = temp;
                      trocou = true;
                    }
                // Se o curso for igual, comparar nome
                  else if (vetor[j].curso == vetor[j + 1].curso) {
                      if (vetor[j].nome > vetor[j + 1].nome) {
                        Aluno temp = vetor[j];
                        vetor[j] = vetor[j + 1];
                        vetor[j + 1] = temp;
                        trocou = true;
                      }
                   }
            }
        if (!trocou) break; // Não houve troca, vetor está ordenado
     }
