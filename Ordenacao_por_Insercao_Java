import java.util.ArrayList;
import java.util.List;

public class Pessoa {

    private String nome;
    private int idade;

    public Pessoa(String nome, int idade) {
        this.nome = nome;
        this.idade = idade;
    }

    public String getNome() {
        return nome;
    }

    public void setNome(String nome) {
        this.nome = nome;
    }

    public int getIdade() {
        return idade;
    }

    public void setIdade(int idade) {
        this.idade = idade;
    }

    public static void insercao(List<Pessoa> lista) {
        int i, j;
        Pessoa pessoaTemp;
        String nometemp;
        int idadetemp;

        for (i = 1; i < lista.size(); i++) {
            pessoaTemp = lista.get(i);
            nometemp = lista.get(i).getNome();
            idadetemp = lista.get(i).getIdade();
            j = i - 1;

            while (j >= 0 && (nometemp.compareTo(lista.get(j).getNome()) < 0
                    || nometemp.compareTo(lista.get(j).getNome()) == 0 && idadetemp < lista.get(j).getIdade())) {
                lista.set(j + 1, lista.get(j));
                j--;
            }
            lista.set(j + 1, pessoaTemp);
        }
    }

    public static void main(String[] args) {
        List<Pessoa> pessoas = new ArrayList();
        pessoas.add(new Pessoa("Marcelo Oliveira Ramos", 22));
        pessoas.add(new Pessoa("Ana Carvalho Souza", 30));
        pessoas.add(new Pessoa("Carlos Ribeiro Andrada", 35));
        pessoas.add(new Pessoa("Bianca Lanes Madureira", 47));
        pessoas.add(new Pessoa("Zeca Marques Silva", 34));
        pessoas.add(new Pessoa("Regina Duarte", 70));
        pessoas.add(new Pessoa("Dudu Santos", 30));
        pessoas.add(new Pessoa("Ana Carvalho Souza", 20));
        pessoas.add(new Pessoa("Zeca Marques Silva", 18));
        pessoas.add(new Pessoa("Paula Oliveira Maciel", 38));
        pessoas.add(new Pessoa("Rogerio dos Santos", 52));
        pessoas.add(new Pessoa("Fabio Lima", 22));
        pessoas.add(new Pessoa("Fabio Alvez", 23));
        pessoas.add(new Pessoa("Paulo Cardozo Galvao", 24));

        System.out.println("Mostrando a lista desordenada: ");
        int posicao = 1;
        for (Pessoa p : pessoas) {
            System.out.println(posicao + " - Nome: " + p.getNome() + " || Idade: " + p.getIdade());
            posicao++;
        }

        System.out.println("--------------------------------");
        System.out.println("Ordenando a lista com Insercao");
        System.out.println("--------------------------------");
        insercao(pessoas);

        System.out.println("Mostrando a lista Ordenada: ");
        posicao = 1;
        for (Pessoa p : pessoas) {
            System.out.println(posicao + " - Nome: " + p.getNome() + " || Idade: " + p.getIdade());
            posicao++;
        }
    }
}
